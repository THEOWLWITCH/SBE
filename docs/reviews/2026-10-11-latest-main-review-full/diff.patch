+  const p = { title: 'נוהל', map: [{ item: 'לוח', level: 'פתוח לקבוצה', where: 'לוח בכיתה', who: 'תורן/ית', when: 'כל ראשון' }], never: ['ב'], handover: ['ג'], check: { every: 'פעם בחודש', questions: ['ד'] } };
