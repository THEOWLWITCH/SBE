 .who b{color:var(--ink);}
 .out{font-family:inherit;font-size:13.5px;font-weight:600;padding:6px 14px;border-radius:6px;border:1px solid var(--hair);
   background:var(--surface);color:var(--ink);cursor:pointer;}
 .banner{border:1px solid var(--hair);border-inline-start:4px solid var(--hidden);background:var(--hidden-soft);color:var(--ink);
   border-radius:8px;padding:10px 14px;margin:0 0 10px;font-size:14.5px;line-height:1.55;}
 .banner.danger{border-inline-start-color:var(--brick);background:var(--brick-soft);}
 .banner a{color:var(--spoken);font-weight:700;}
 h2{font-family:"Frank Ruhl Libre",Georgia,serif;font-size:18px;margin:22px 0 10px;}
+.rgroup{font-size:15.5px;margin:18px 0 8px;color:var(--spoken);}
 .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}
 .tile{display:block;background:var(--surface);border:1px solid var(--hair);border-radius:10px;padding:13px 15px;
   text-decoration:none;color:var(--ink);box-shadow:0 1px 3px var(--shadow);transition:border-color .12s;}
 .tile:hover{border-color:var(--spoken);}
 .tile b{display:block;font-size:15.5px;margin-bottom:3px;}
 .tile span{font-size:13px;color:var(--muted);line-height:1.45;display:block;}
 .empty{background:var(--surface);border:1px dashed var(--hair);border-radius:10px;padding:16px;color:var(--muted);font-size:14.5px;}
 .card{background:var(--surface);border:1px solid var(--hair);border-radius:10px;padding:14px 16px;margin-bottom:12px;box-shadow:0 1px 3px var(--shadow);}
 .card h3{margin:0 0 6px;font-size:16px;}
 .card p.sub{margin:0 0 10px;font-size:13.5px;color:var(--muted);}
